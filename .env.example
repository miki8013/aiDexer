# Copy to .env.local and fill in. NEVER commit .env.local.

# --- Database (required for auth + persistent community data) ---
# Recommended: Neon Postgres via the Vercel Marketplace (Storage tab →
# "Marketplace" → Neon → free Hobby plan: 0.5 GB, auto-injected DATABASE_URL).
# For local dev you can also run any Postgres and paste its URL here.
DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Better Auth ---
# Generate a strong secret:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# --- AI recommendations (optional; AI Mode falls back to keyword engine) ---
# Free instant keyword engine needs no keys at all.
# Only needed when the user flips the "Use AI" toggle on (Gemini mode).
# Get a free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Optional: where the legacy JSON fallback store writes (no DB mode) ---
# AIDEXER_DATA_DIR=./.data
